{
  "name": "sipstore",
  "compatibility_date": "2024-12-30",
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "main": "./api/index.ts",
}
{
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "enable_esm"
  ],
  "build": {
    "command": "npm run build",
    "cwd": "./api",
    "watch_dir": "./api"
  },
  "env": {
    "production": {
      "compatibility_date": "2024-12-30",
      "compatibility_flags": [
        "enable_esm"
      ]
    }
  },
  "bindings": [
    {
      "name": "DB",
      "database_name": "sipstore-db",
      "database_id": "ce52610d-e503-40c8-ab40-22306964e7c5"
    }
  ]
}