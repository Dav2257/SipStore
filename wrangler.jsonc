{
  // Nama aplikasi
  "name": "sipstore-app",

  // Tanggal kompatibilitas untuk Worker
  "compatibility_date": "2025-04-17",

  // Perintah build untuk proyek
  "build": {
    "command": "npm run build",
  },

  // Konfigurasi untuk situs statis
  "site": {
    "bucket": "dist", // Folder hasil build
    "entry-point": "functions", // Lokasi fungsi Worker
  },

  // Konfigurasi database D1
  "d1_databases": [
    {
      "binding": "DB", // Nama binding untuk database
      "database_name": "sipstore-db", // Nama database
      "database_id": "ce52610d-e503-40c8-ab40-22306964e7c5", // ID database
    },
  ],
}
